// Street lamp, 6 m tall. The light hangs out over +X: face +X towards the road.

material(plastic, paint(#3A3D42,
    move(0, 1.5, 0, cylinder(1.4, 3)),
    move(0, 30, 0, cone(0.8, 0.5, 55)),
    move(0, 57.5, 0, sphere(0.6)),
    move(4.8, 57.6, 0, rotateZ(90, cylinder(0.35, 9.6))),
    move(9.5, 57.1, 0, cube(4, 1, 2.2))))
material(neon, paint(#FFF1C0, move(9.5, 56.55, 0, cube(3.4, 0.2, 1.8))))
