// Small rock, about 80 cm across. Flat underneath.

blob = move(0, 1.4, 0, scale(4, 3, 3.4, sphere(1)))
cutA = move(0, 1.6, 0, rotateY(-30, rotateX(18, cube(6.4, 4.6, 5.2))))
cutB = move(0.3, 1.5, 0, rotateZ(28, rotateY(40, cube(6, 5, 5.6))))
rock = intersection(blob, intersection(cutA, cutB))
material(matte, paint(#8A867F, intersection(rock, move(0, 10, 0, cube(20, 20, 20)))))
