// Low bush, 2.4 m across, 1 m tall. Flat underneath.

blobs = group(move(0, 4, 0, sphere(5)), move(5, 2.8, 2, sphere(4)), move(-5, 3, -1, sphere(4.2)), move(1, 3, -5, sphere(3.8)), move(-2, 2.6, 5, sphere(3.6)))
material(matte, paint(#3E7A2E, intersection(blobs, move(0, 10, 0, cube(40, 20, 40)))))
